  "guardedGitFiles": {
    "readQuery": {
      "path": "drafts/notes.txt",
      "include_revision": "true"
    },
    "upload": {
      "path": "drafts",
      "message": "Update release notes",
      "files": [
        {
          "name": "notes.txt",
          "url": "https://example.com/staged/notes.txt",
          "expected_sha": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        }
      ]
    },
    "uploadSchema": {
      "type": "object",
      "required": [
        "files"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "Target directory within the resolved repository; omitted or empty means root. Use a canonical relative path. Dot/traversal segments, backslashes, control characters, malformed Unicode and leading/trailing/doubled slashes return 400. These checks also apply to legacy requests.",
          "example": "assets/images"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "url",
              "name"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri",
                "description": "The URL of the file to upload",
                "example": "https://example.com/files/album-cover.png"
              },
              "name": {
                "type": "string",
                "description": "Nonempty relative file name/path under the target directory. Use a canonical relative path. Dot/traversal segments, backslashes, control characters, malformed Unicode and leading/trailing/doubled slashes return 400. These checks also apply to legacy requests.",
                "example": "album-cover.png",
                "minLength": 1
              },
              "expected_sha": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$",
                "description": "Optional observed blob SHA from the matching versioned read. When provided, update the existing file on main only if its current contents still match. Omission retains unguarded legacy create/update behavior; no automatic conflict retry occurs. See the upload operation's missing-target recovery guidance before retrying a failed save.",
                "example": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
              }
            }
          },
          "description": "Array of files to upload, each with a URL and target filename",
          "minItems": 1
        },
        "message": {
          "type": "string",
          "description": "Optional commit message. Defaults to 'Upload files via API'.",
          "example": "Add new album artwork"
        }
      },
      "example": {
        "path": "drafts",
        "message": "Update release notes",
        "files": [
          {
            "name": "notes.txt",
            "url": "https://example.com/staged/notes.txt",
            "expected_sha": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
          }
        ]
      }
    },
    "responses": [
      {
        "method": "GET",
        "path": "/api/sandboxes/file",
        "status": 200,
        "schema": {
          "type": "object",
          "required": [
            "status",
            "content"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "success"
              ],
              "description": "Status of the operation"
            },
            "content": {
              "type": "string",
              "description": "Text content, or base64 bytes for recognized binary extensions. Decode when encoding is base64. Versioned reads reject unknown non-UTF-8 binary content."
            },
            "encoding": {
              "type": "string",
              "enum": [
                "base64"
              ],
              "description": "Present for recognized binary extensions, on both legacy and versioned reads. When absent, content is text."
            },
            "sha": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$",
              "description": "Present when include_revision=true; use this reader-observed blob SHA as files[].expected_sha. Absent from legacy reads. It identifies the returned bytes, not an accepted Context source version.",
              "example": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
            }
          }
        }
      },
      {
        "method": "POST",
        "path": "/api/sandboxes/files",
        "status": 200,
        "schema": {
          "type": "object",
          "required": [
            "status",
            "uploaded"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "success"
              ],
              "description": "Status of the operation"
            },
            "uploaded": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "description": "The full path of the uploaded file in the repository"
                  },
                  "sha": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{40}$",
                    "description": "Blob SHA of the newly saved file. Retain it as the next observed condition when editing these saved bytes.",
                    "example": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
                  }
                },
                "required": [
                  "path",
                  "sha"
                ]
              },
              "description": "Array of uploaded file details",
              "minItems": 1
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Per-file failures retained alongside successful receipts. HTTP 200 does not mean every file was saved."
            },
            "conflicts": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "description": "Submitted names of files rejected because their observed revision no longer matches."
            }
          }
        }
      },
      {
        "method": "POST",
        "path": "/api/sandboxes/files",
