{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/internal/catalog-stream-maintenance",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/internal/credit-spend-digest",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/internal/playcount-maintenance",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/internal/context-guest-maintenance",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/internal/missed-report-check",
      "schedule": "17 * * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "fix/mcp-oauth-behavior-annotations": false
    }
  }
}
